JOIN pq_engineer_project_history h ON h.engr_id = r.engineer_id
  AND h.seq = r.source_seq
JOIN company_performances cp ON cp.seq = h.seq
WHERE r.bid_seq = 20261083
  AND r.engineer_id ='444'
  AND ( h.seq IN ( SELECT k.seq
FROM company_performance_construction_kinds k
WHERE k.level1_code ='12'
  AND ('02' IS NULL
  OR k.level2_code ='02')
  AND ('01' IS NULL
  OR k.level3_code ='01') )
  OR h.seq IN ( SELECT k.seq
FROM company_performance_construction_kinds k
WHERE k.level1_code ='14'
  AND ('01' IS NULL
  OR k.level2_code ='01')
  AND ('01' IS NULL
  OR k.level3_code ='01') )
  OR h.seq IN ( SELECT k.seq
FROM company_performance_construction_kinds k
WHERE k.level1_code ='14'
  AND ('01' IS NULL
  OR k.level2_code ='01')
  AND ('17' IS NULL
  OR k.level3_code ='17') )
  AND h.seq IN ( SELECT cp.seq
FROM company_performances cp
WHERE cp.contract_to_date >='20160803' )
  AND h.seq IN ( SELECT cp.seq
FROM company_performances cp
WHERE LOWER(CAST(cp.contract_amt AS TEXT)) LIKE'%500000000%' ) )
ORDER BY cp.contract_to_date DESC NULLS LAST, h.enddt DESC NULLS LAST, h.seq DESC, r.review_id
