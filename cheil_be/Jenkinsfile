pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'TARGET_ENV', choices: ['dev', 'prod'], description: '배포 대상 환경')
        booleanParam(name: 'DEPLOY', defaultValue: false, description: '체크하면 선택한 환경으로 배포')
    }

    environment {
        APP_NAME = 'cheil-be'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh './gradlew test'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew bootJar'
            }
        }

        stage('Deploy') {
            when {
                expression { return params.DEPLOY }
            }
            steps {
                script {
                    def envName = params.TARGET_ENV
                    def remoteHost = envName == 'dev' ? env.DEV_DEPLOY_HOST : env.PROD_DEPLOY_HOST
                    def remoteUser = envName == 'dev' ? env.DEV_DEPLOY_USER : env.PROD_DEPLOY_USER
                    def remotePath = envName == 'dev' ? env.DEV_DEPLOY_PATH : env.PROD_DEPLOY_PATH
                    def branchName = envName == 'dev' ? env.DEV_DEPLOY_BRANCH : env.PROD_DEPLOY_BRANCH
                    def composeFile = "docker/${envName}/compose.app.yaml"
                    def infraFile = "docker/${envName}/compose.infra.yaml"
                    def obsFile = "docker/${envName}/compose.observability.yaml"

                    sh """
                        ssh ${remoteUser}@${remoteHost} '
                            cd ${remotePath} &&
                            git fetch origin ${branchName} &&
                            git reset --hard origin/${branchName} &&
                            docker compose -f ${infraFile} -f ${composeFile} -f ${obsFile} up -d --build
                        '
                    """
                }
            }
        }
    }
}
