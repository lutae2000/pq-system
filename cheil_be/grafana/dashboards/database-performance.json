{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "PostgreSQL availability, resource, connection and workload metrics.",
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 0, "id": null,
  "panels": [
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }, "id": 1, "targets": [{ "expr": "min(pg_up{instance=~\"$instance\"})", "refId": "A" }], "title": "PostgreSQL Up", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "id": 2, "targets": [{ "expr": "100 * sum(rate(container_cpu_usage_seconds_total{name=~\".*-postgres-1$\"}[$__rate_interval])) / clamp_min(scalar(max(count by (instance) (node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"}))), 1)", "legendFormat": "postgres", "refId": "A" }], "title": "DB CPU Usage", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "id": 3, "targets": [{ "expr": "100 * max by (name) (container_memory_working_set_bytes{name=~\".*-postgres-1$\"}) / clamp_min(scalar(max(machine_memory_bytes)), 1)", "legendFormat": "{{name}}", "refId": "A" }], "title": "DB Memory Usage", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }, "id": 4, "targets": [{ "expr": "100 * sum by (instance) (pg_stat_activity_count{instance=~\"$instance\"}) / clamp_min(sum by (instance) (pg_settings_max_connections{instance=~\"$instance\"}), 1)", "legendFormat": "{{instance}}", "refId": "A" }], "title": "Connection Utilization", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "ops" } }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }, "id": 5, "targets": [{ "expr": "sum by (instance) (rate(pg_stat_database_xact_commit{instance=~\"$instance\",datname!~\"template0|template1\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{instance=~\"$instance\",datname!~\"template0|template1\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "refId": "A" }], "title": "Transaction Rate", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 }, "id": 6, "targets": [{ "expr": "100 * sum(rate(pg_stat_database_blks_hit{instance=~\"$instance\",datname!~\"template0|template1\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{instance=~\"$instance\",datname!~\"template0|template1\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{instance=~\"$instance\",datname!~\"template0|template1\"}[$__rate_interval])), 1)", "legendFormat": "cache hit ratio", "refId": "A" }], "title": "Cache Hit Ratio", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 }, "id": 7, "targets": [{ "expr": "sum by (instance) (pg_locks_count{instance=~\"$instance\"})", "legendFormat": "{{instance}} locks", "refId": "A" }, { "expr": "sum by (instance) (rate(pg_stat_database_deadlocks{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} deadlocks", "refId": "B" }], "title": "Locks and Deadlocks", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 }, "id": 8, "targets": [{ "expr": "sum by (state) (pg_stat_activity_count{instance=~\"$instance\"})", "legendFormat": "{{state}}", "refId": "A" }], "title": "Sessions by State", "type": "timeseries" }
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["database", "postgresql", "prometheus"],
  "templating": { "list": [
    { "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(pg_up, instance)", "includeAll": true, "label": "DB Instance", "multi": true, "name": "instance", "query": { "query": "label_values(pg_up, instance)", "refId": "DatabaseVariable" }, "refresh": 1, "type": "query" },
    { "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(node_cpu_seconds_total, instance)", "includeAll": true, "label": "Node Instance", "multi": true, "name": "node_instance", "query": { "query": "label_values(node_cpu_seconds_total, instance)", "refId": "NodeVariable" }, "refresh": 1, "type": "query" }
  ] },
  "time": { "from": "now-6h", "to": "now" }, "timezone": "browser", "title": "Database Performance", "uid": "database-performance", "version": 1
}
