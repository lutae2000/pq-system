{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "Redis availability, memory, traffic, hit ratio and pressure metrics.",
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 0, "id": null,
  "panels": [
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }, "id": 1, "targets": [{ "expr": "min(redis_up{instance=~\"$instance\"})", "refId": "A" }], "title": "Redis Up", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }, "id": 2, "targets": [{ "expr": "redis_connected_clients{instance=~\"$instance\"}", "refId": "A" }], "title": "Connected Clients", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "bytes" } }, "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }, "id": 3, "targets": [{ "expr": "redis_memory_used_bytes{instance=~\"$instance\"}", "refId": "A" }], "title": "Memory Used", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }, "id": 4, "targets": [{ "expr": "100 * redis_memory_used_bytes{instance=~\"$instance\"} / clamp_min(redis_memory_max_bytes{instance=~\"$instance\"}, 1)", "refId": "A" }], "title": "Memory Usage", "type": "stat" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "id": 5, "targets": [{ "expr": "100 * sum(rate(redis_keyspace_hits_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(redis_keyspace_hits_total{instance=~\"$instance\"}[$__rate_interval])) + sum(rate(redis_keyspace_misses_total{instance=~\"$instance\"}[$__rate_interval])), 1)", "legendFormat": "hit ratio", "refId": "A" }], "title": "Keyspace Hit Ratio", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "ops" } }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "id": 6, "targets": [{ "expr": "sum(rate(redis_commands_total{instance=~\"$instance\"}[$__rate_interval])) by (instance)", "legendFormat": "{{instance}}", "refId": "A" }], "title": "Command Rate", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "ops" } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }, "id": 7, "targets": [{ "expr": "rate(redis_evicted_keys_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}}", "refId": "A" }], "title": "Evictions Rate", "type": "timeseries" },
    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "short" } }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }, "id": 8, "targets": [{ "expr": "redis_blocked_clients{instance=~\"$instance\"}", "refId": "A" }, { "expr": "sum(redis_db_keys{instance=~\"$instance\"}) by (instance)", "legendFormat": "keys {{instance}}", "refId": "B" }], "title": "Blocked Clients and Keys", "type": "timeseries" }
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["redis", "prometheus", "cache"],
  "templating": { "list": [{ "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(redis_up, instance)", "includeAll": true, "label": "Instance", "multi": true, "name": "instance", "query": { "query": "label_values(redis_up, instance)", "refId": "RedisVariable" }, "refresh": 1, "type": "query" }] },
  "time": { "from": "now-6h", "to": "now" }, "timezone": "browser", "title": "Redis Performance", "uid": "redis-performance", "version": 1
