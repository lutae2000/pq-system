      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_count{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "gc pauses/sec",
          "refId": "A"
        }
