      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "id": 12,
      "targets": [
        {
          "expr": "jvm_classes_loaded_classes{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "loaded classes",
          "refId": "A"
        },
        {
          "expr": "jvm_classes_unloaded_classes_total{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "unloaded classes",
          "refId": "B"
        }
      ],
      "title": "Class Loading",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "id": 13,
      "targets": [
        {
          "expr": "process_files_open_files{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "open files",
          "refId": "A"
        },
        {
          "expr": "process_files_max_files{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "max files",
          "refId": "B"
        },
        {
          "expr": "system_load_average_1m{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "load avg",
          "refId": "C"
        }
      ],
      "title": "Process Resources",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 14,
      "targets": [
        {
          "expr": "tomcat_sessions_active_current_sessions{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "active sessions",
          "refId": "A"
        },
        {
          "expr": "tomcat_threads_current_threads{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "current threads",
          "refId": "B"
        },
        {
          "expr": "tomcat_threads_busy_threads{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "busy threads",
          "refId": "C"
        }
      ],
      "title": "Tomcat Sessions and Threads",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 15,
      "targets": [
        {
          "expr": "topk(10, sum by (uri, method) (rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",status=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Top 5xx Endpoints",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 16,
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Top p95 Slow Endpoints",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 17,
      "targets": [
        {
          "expr": "sum by (level) (rate(logback_events_total{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "Logback Events",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 56 },
      "id": 18,
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Node CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 56 },
      "id": 19,
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"$node_instance\"} / node_memory_MemTotal_bytes{instance=~\"$node_instance\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Node Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 56 },
      "id": 20,
      "targets": [
        {
          "expr": "node_load1{instance=~\"$node_instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Node Load Average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "id": 21,
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{instance=~\"$node_instance\",fstype!~\"tmpfs|squashfs|overlay\",mountpoint!~\"/run.*|/var/lib/docker/.+\"} / node_filesystem_size_bytes{instance=~\"$node_instance\",fstype!~\"tmpfs|squashfs|overlay\",mountpoint!~\"/run.*|/var/lib/docker/.+\"}))",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Node Filesystem Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 64 },
      "id": 22,
      "targets": [
        {
          "expr": "pg_up{instance=~\"$db_instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 72 },
      "id": 23,
      "targets": [
        {
          "expr": "sum by (instance) (pg_stat_activity_count{instance=~\"$db_instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 72 },
      "id": 24,
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{instance=~\"$db_instance\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{instance=~\"$db_instance\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{instance=~\"$db_instance\"}[$__rate_interval])))",
          "legendFormat": "cache hit",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Cache Hit Ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 80 },
      "id": 25,
      "targets": [
        {
          "expr": "sum by (instance) (rate(pg_stat_database_xact_commit{instance=~\"$db_instance\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{instance=~\"$db_instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Transaction Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
