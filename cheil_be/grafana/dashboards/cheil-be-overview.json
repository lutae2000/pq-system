      "id": 8,
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "live threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "daemon threads",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "peak threads",
