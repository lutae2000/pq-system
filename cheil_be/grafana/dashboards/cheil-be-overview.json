  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx/sec",
          "refId": "A"
        }
      ],
      "title": "5xx Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "title": "Error Ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\",environment=~\"$environment\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "HTTP Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=~\"$application\",environment=~\"$environment\",area=\"heap\"}",
          "legendFormat": "heap used {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{application=~\"$application\",environment=~\"$environment\",area=\"heap\"}",
          "legendFormat": "heap max {{id}}",
          "refId": "B"
        }
      ],
      "title": "JVM Heap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=~\"$application\",environment=~\"$environment\",area=\"nonheap\"}",
          "legendFormat": "non-heap used {{id}}",
