    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 12, "x": 12, "y": 88 },
      "id": 27,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"cheil-be\"} |= \"ERROR\"",
          "refId": "A"
        }
      ],
      "title": "에러 로그 보기",
      "type": "logs"
    }
