        {
          "expr": "jvm_memory_max_bytes{application=~\"$application\",environment=~\"$environment\",area=\"nonheap\"}",
          "legendFormat": "non-heap max {{id}}",
          "refId": "B"
        }
      ],
      "title": "JVM Non-Heap",
