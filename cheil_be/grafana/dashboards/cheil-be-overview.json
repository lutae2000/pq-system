    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 10,
      "targets": [
        {
          "expr": "process_resident_memory_bytes{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "resident memory",
          "refId": "A"
        },
        {
          "expr": "process_virtual_memory_bytes{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "virtual memory",
          "refId": "B"
        }
      ],
      "title": "Process Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "id": 11,
      "targets": [
        {
          "expr": "process_uptime_seconds{application=~\"$application\",environment=~\"$environment\"}",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ],
      "title": "Process Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
