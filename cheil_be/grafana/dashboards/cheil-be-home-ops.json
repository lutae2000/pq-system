          },
          {
            "matcher": {
              "id": "byName",
              "options": "Method"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "URI"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Loki에서 오류 원문 보기",
                    "targetBlank": true,
                    "url": "",
                    "internal": {
                      "datasourceUid": "loki",
                      "datasourceName": "Loki",
                      "query": {
                        "expr": "{app=\"cheil-be\"} |= \"api_error\" |= \"method=${__data.fields.Method}\" |= \"uri_pattern=${__value.raw}\"",
                        "queryType": "range",
                        "refId": "A"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "원인 예외"
