        "cellHeight": "sm"
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{app=\"cheil-be\"} |= \"api_error\" | regexp `api_error method=(?P<method>\\S+) uri=(?P<uri>\\S+) uri_pattern=(?P<uri_pattern>\\S+) status=(?P<status>\\d+) error_type=(?P<error_type>\\S+) error_message=\"(?P<error_message>[^\"]*)\" root_cause_type=(?P<root_cause_type>\\S+) root_cause_message=\"(?P<root_cause_message>[^\"]*)\" trace_id=(?P<trace_id>\\w+)` | error_type != \"\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "source": "labels",
            "replace": true,
            "keepTime": true,
            "jsonPaths": []
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "app": true,
              "error_message": true,
              "error_type": true,
              "filename": true,
              "id": true,
              "job": true,
              "labels": true,
              "source": true,
              "status": true,
              "tsNs": true,
              "uri": true
            },
            "indexByName": {
              "Time": 0,
              "trace_id": 1,
              "method": 2,
              "uri_pattern": 3,
              "root_cause_type": 4,
              "root_cause_message": 5
            },
            "renameByName": {
              "Time": "발생 시간",
              "trace_id": "Trace ID",
              "method": "Method",
              "uri_pattern": "URI",
              "root_cause_type": "원인 예외",
              "root_cause_message": "상세 오류"
            }
          }
        }
      ],
      "title": "API 5xx Error Logs (Loki)",
      "type": "table",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
