              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo에서 Trace 보기",
                    "targetBlank": true,
                    "url": "",
                    "internal": {
                      "datasourceUid": "tempo",
                      "datasourceName": "Tempo",
                      "query": {
                        "query": "${__value.raw}",
