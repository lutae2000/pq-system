    { "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 }, "id": 6, "targets": [{ "expr": "100 * jvm_memory_used_bytes{application=~\"$application\",environment=~\"$environment\",area=\"heap\"} / clamp_min(jvm_memory_max_bytes{application=~\"$application\",environment=~\"$environment\",area=\"heap\"}, 1)", "legendFormat": "{{id}}", "refId": "A" }], "title": "JVM Heap Usage", "type": "timeseries" },
