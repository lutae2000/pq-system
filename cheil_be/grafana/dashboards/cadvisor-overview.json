{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Container resource overview from cAdvisor and Prometheus.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Explore",
      "url": "/explore",
      "type": "link",
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "cpu cores",
          "refId": "A"
        }
      ],
      "title": "Total Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\",image!=\"\"})",
          "legendFormat": "working set",
          "refId": "A"
        }
      ],
      "title": "Total Container Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{container!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "rx",
          "refId": "A"
        }
      ],
      "title": "Network Receive Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{container!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "tx",
          "refId": "A"
        }
      ],
      "title": "Network Transmit Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "targets": [
        {
          "expr": "topk(10, container_memory_working_set_bytes{container!=\"\",image!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Top Containers by Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "targets": [
        {
          "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Top Containers by CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(container_fs_usage_bytes{container!=\"\",image!=\"\"})",
          "legendFormat": "fs usage",
          "refId": "A"
        }
      ],
      "title": "Filesystem Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "targets": [
        {
          "expr": "count(container_last_seen{container!=\"\",image!=\"\"})",
          "legendFormat": "containers",
          "refId": "A"
        }
      ],
      "title": "Observed Containers",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["docker", "cadvisor", "prometheus", "containers"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(container_cpu_usage_seconds_total, name)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "query": { "query": "label_values(container_cpu_usage_seconds_total, name)", "refId": "PrometheusVariableQueryEditor-Container" },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "cAdvisor Overview",
  "uid": "cadvisor-overview",
  "version": 1,
  "weekStart": ""
}
