import { readdir, readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.resolve(__dirname, "..");
const appDir = path.join(projectRoot, "app");
const registryOutputFile = path.join(projectRoot, "shared", "navigation", "pageRegistry.generated.tsx");
const excludedRoutes = new Set(["/", "/login"]);

async function findPageFiles(dir: string): Promise<string[]> {
  const entries = await readdir(dir, { withFileTypes: true });
  const files: string[] = [];

  for (const entry of entries) {
    const fullPath = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      files.push(...(await findPageFiles(fullPath)));
      continue;
    }

    if (entry.isFile() && entry.name === "page.tsx") {
      files.push(fullPath);
    }
  }

  return files;
}

function toRoutePath(pageFile: string) {
  const relativeDir = path.relative(appDir, path.dirname(pageFile));
  if (!relativeDir) {
    return "/";
  }
  return `/${relativeDir.split(path.sep).join("/")}`;
}

function normalizeSource(source: string) {
  return `${source.trim()}\n`;
}

function parsePageComponent(pageFile: string, source: string) {
  const importMatch = source.match(/import\s+\{\s*([A-Za-z0-9_]+)\s*}\s+from\s+"([^"]+)";/);

  if (!importMatch) {
    throw new Error(`Unable to parse page component import from ${pageFile}`);
  }

  return {
    exportName: importMatch[1],
    modulePath: importMatch[2],
  };
}

const pageFiles = (await findPageFiles(appDir))
  .map((pageFile) => ({ pageFile, routePath: toRoutePath(pageFile) }))
  .filter(({ routePath }) => !excludedRoutes.has(routePath))
  .sort((left, right) => left.routePath.localeCompare(right.routePath));

const pageEntries = await Promise.all(
  pageFiles.map(async ({ pageFile, routePath }, index) => {
    const source = await readFile(pageFile, "utf8");
    const { exportName, modulePath } = parsePageComponent(pageFile, source);

    return {
      exportName,
      componentName: `GeneratedPageComponent${index}`,
      modulePath,
      routePath,
    };
  }),
);

const registryComponents = pageEntries
  .map(
    ({ componentName, exportName, modulePath }) =>
      `const load${componentName} = () => import("${modulePath}").then((module) => module.${exportName});\nconst ${componentName} = dynamic(load${componentName}, { ssr: false });`,
  )
  .join("\n");

const registryEntries = pageEntries
  .map(({ componentName, routePath }) => `  "${routePath}": ${componentName},`)
  .join("\n");

const preloaderEntries = pageEntries
  .map(({ componentName, routePath }) => `  ["${routePath}", load${componentName}],`)
  .join("\n");

const generatedRegistry = normalizeSource(`
"use client";

/* This file is generated by scripts/generate-page-registry.mts.
 * Do not edit manually. It maps menu route paths to client page components
 * so the tab outlet can keep mounted pages alive across tab switches.
 */

import dynamic from "next/dynamic";

${registryComponents}

export const pageRegistry = {
${registryEntries}
};

const pagePreloaders = new Map([
${preloaderEntries}
]);

export function preloadRegisteredPage(pathname = "") {
  const preloader = pagePreloaders.get(pathname);
  if (preloader) {
    void preloader().catch(() => undefined);
  }
}
`);

const currentRegistry = await readFile(registryOutputFile, "utf8").catch(() => "");
if (currentRegistry !== generatedRegistry) {
  await writeFile(registryOutputFile, generatedRegistry, "utf8");
}
