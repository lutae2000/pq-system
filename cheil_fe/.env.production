# Internal backend URL for the shared Kubernetes image
NEXT_API_BASE_URL=http://merp-backend:8080

# Frontend axios headers
NEXT_API_KEY=30aafc86257cbf251b0307cfc2cf5243f66fad37d63e2693176f451e83c301a8
NEXT_SERVICE_ID=application

# Route guard
NEXT_PUBLIC_APP_PROFILE=prod
NEXT_PUBLIC_ROUTE_GUARD_ENABLED=true

# Session and request timeout
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=60

# File upload
NEXT_PUBLIC_FILE_UPLOAD_MAX_SIZE_BYTES=20971520
NEXT_PUBLIC_FILE_UPLOAD_MAX_FILENAME_LENGTH=255
NEXT_PUBLIC_FILE_UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,hwp,hwpx,txt,csv,jpg,jpeg,png,gif,zip
NEXT_PUBLIC_FILE_UPLOAD_BLOCKED_EXTENSIONS=exe,bat,cmd,com,dll,msi,sh,bash,ps1,jar,war,ear,js,vbs,wsf,hta,scr,reg
