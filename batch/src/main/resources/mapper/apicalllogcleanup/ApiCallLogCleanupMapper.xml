<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cheil.batch.apicalllogcleanup.ApiCallLogCleanupMapper">

    <delete id="deleteExpiredApiCallLogs"><![CDATA[
        DELETE FROM api_call_logs
        WHERE occurred_at < CURRENT_TIMESTAMP - (#{retentionMonths} * INTERVAL '1 month')
    ]]></delete>
</mapper>
